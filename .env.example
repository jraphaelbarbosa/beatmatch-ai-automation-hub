# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apify Credentials (for YouTube & Twitter Scrapers)
APIFY_TOKEN=your_apify_token_here

# Database Configuration (Supabase PostgreSQL via IPv4 Connection Pooler)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Monday.com Integration
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_BOARD_ID=your_monday_board_id_here

# Telegram Bot (Monitoring & Telemetry Reports)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# YouTube API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Pipeline Settings
BATCH_SIZE=50
PORT=10000

# Google Gemini API Key (for Talent Classifier)
GEMINI_API_KEY=your_gemini_api_key_here

# Host Runner Security Token (used by n8n HTTP Request nodes)
HOST_RUNNER_TOKEN=generate_a_secure_random_token_here
